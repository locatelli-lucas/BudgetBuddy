# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/budgetbuddy
DATABASE_USER=budgetbuddy
DATABASE_PASSWORD=budgetbuddy

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-minimum-64-characters-long-for-hs512

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Mail (SMTP) ──────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@budgetbuddy.app

# ─── AI Providers ─────────────────────────────────────────────────────────────
AI_PROVIDER=groq
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...

# ─── Firebase FCM ─────────────────────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
FIREBASE_PROJECT_ID=budgetbuddy-firebase

# ─── External APIs ────────────────────────────────────────────────────────────
NEWS_API_KEY=your-newsapi-key

# ─── App ──────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:3000
SPRING_PROFILES_ACTIVE=dev
